# Copy this file to ".env" and fill in your real Angel One values.
# The .env file is git-ignored, so your secrets stay on your machine.

ANGEL_API_KEY=your_api_key_here      # from the SmartAPI developer portal
ANGEL_CLIENT_CODE=your_client_code   # your Angel One login ID
ANGEL_MPIN=your_mpin                 # your account MPIN (or password)
ANGEL_TOTP_SECRET=your_totp_secret   # the 2FA secret key (not the 6-digit code)
